{
  "name": "scarlet-archive-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets:fetch": "node scripts/fetch-character-art.mjs",
    "predev": "npm run assets:fetch",
    "prebuild": "npm run assets:fetch",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "format": "prettier --plugin=prettier-plugin-java --write \"src/**/*.{ts,vue,css}\" \"tests/*.ts\" \"../backend/src/**/*.java\"",
    "format:check": "prettier --plugin=prettier-plugin-java --check \"src/**/*.{ts,vue,css}\" \"tests/*.ts\" \"../backend/src/**/*.java\"",
    "screenshots": "node scripts/capture.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "gsap": "^3.14.2",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.11.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "undici": "^7.30.1",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  }
}
